# Database: serverless runtime via Supavisor (port 6543)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Supabase Auth / SSR
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UUID of the user already provisioned in Supabase Auth. The seed never creates passwords.
SUPABASE_TEACHER_USER_ID="00000000-0000-4000-8000-000000000000"

# Optional, when Sentry is configured
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

